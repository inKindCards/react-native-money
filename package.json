{
  "name": "@inkindcards/react-native-money",
  "version": "2.0.0",
  "description": "A fully native TextInput component that allows currency input with a right to left text aligment",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "android/src/",
    "android/build.gradle",
    "android/gradle/",
    "android/gradlew",
    "android/gradlew.bat",
    "ios/*.swift",
    "ios/*.h",
    "ios/*.m",
    "ios/*.mm",
    "ios/*.xcodeproj/project.pbxproj",
    "ios/*.xcworkspace/contents.xcworkspacedata",
    "ios/*.xcworkspace/xcshareddata/",
    "react-native-money.podspec",
    "index.tsx",
    "!android/build/",
    "!android/.gradle/",
    "!android/.idea/",
    "!android/local.properties",
    "!ios/build/",
    "!ios/Pods/",
    "!**/__tests__",
    "!**/__mocks__",
    "!**/xcuserdata/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inKindCards/react-native-money.git"
  },
  "keywords": [
    "react",
    "native",
    "money",
    "currency",
    "currency field",
    "money field",
    "currency input",
    "money input",
    "text input",
    "android",
    "ios"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "format": "prettier --write ./index.tsx"
  },
  "devDependencies": {
    "@react-native-community/eslint-config": "0.0.2",
    "@types/react": "^16.9.50",
    "@types/react-native": "^0.63.45",
    "react-native": "^0.64.1",
    "tslib": "^2.1.0",
    "typescript": "^4.5.4",
    "prettier": "^2.5.1"
  },
  "peerDependencies": {
    "react-native": ">=0.62.2"
  },
  "author": "Nathan Horrigan",
  "bugs": {
    "url": "https://github.com/inKindCards/react-native-money"
  },
  "homepage": "https://github.com/inKindCards/react-native-money",
  "dependencies": {},
  "license": "MIT"
}
